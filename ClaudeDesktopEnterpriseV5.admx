<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions
  revision="1.0"
  schemaVersion="1.0"
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">

  <policyNamespaces>
    <target prefix="ClaudeDesktop" namespace="Anthropic.Policies.ClaudeDesktop"/>
  </policyNamespaces>

  <resources minRequiredRevision="1.0"/>

  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_ClaudeDesktop" displayName="$(string.SUPPORTED_ClaudeDesktop)"/>
    </definitions>
  </supportedOn>

  <categories>
    <category name="ClaudeDesktop" displayName="$(string.CAT_ClaudeDesktop)"/>

    <category name="Authentication" displayName="$(string.CAT_Authentication)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>

    <category name="Updates" displayName="$(string.CAT_Updates)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>

    <category name="ClaudeCode" displayName="$(string.CAT_ClaudeCode)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>

    <category name="Cowork" displayName="$(string.CAT_Cowork)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>

    <category name="Features" displayName="$(string.CAT_Features)">
      <parentCategory ref="ClaudeDesktop"/>
    </category>
  </categories>

  <policies>

    <!-- ================================================== -->
    <!-- Automatic Updates                                  -->
    <!-- ================================================== -->

    <policy
      name="DisableAutoUpdatesMachine"
      class="Machine"
      displayName="$(string.DisableAutoUpdates)"
      explainText="$(string.DisableAutoUpdates_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="disableAutoUpdates">

      <parentCategory ref="Updates"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="DisableAutoUpdatesUser"
      class="User"
      displayName="$(string.DisableAutoUpdates)"
      explainText="$(string.DisableAutoUpdates_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="disableAutoUpdates">

      <parentCategory ref="Updates"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="AutoUpdaterEnforcementHoursMachine"
      class="Machine"
      displayName="$(string.AutoUpdaterHours)"
      explainText="$(string.AutoUpdaterHours_Help)"
      presentation="$(presentation.AutoUpdaterEnforcementHoursMachine)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Updates"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <decimal
          id="AutoUpdaterHoursValue"
          valueName="autoUpdaterEnforcementHours"
          minValue="1"
          maxValue="72"
          required="true"/>
      </elements>
    </policy>

    <policy
      name="AutoUpdaterEnforcementHoursUser"
      class="User"
      displayName="$(string.AutoUpdaterHours)"
      explainText="$(string.AutoUpdaterHours_Help)"
      presentation="$(presentation.AutoUpdaterEnforcementHoursUser)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Updates"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <decimal
          id="AutoUpdaterHoursUserValue"
          valueName="autoUpdaterEnforcementHours"
          minValue="1"
          maxValue="72"
          required="true"/>
      </elements>
    </policy>

    <!-- ================================================== -->
    <!-- Authentication                                     -->
    <!-- ================================================== -->

    <policy
      name="ForceLoginOrgUUIDMachine"
      class="Machine"
      displayName="$(string.ForceLoginOrgUUID)"
      explainText="$(string.ForceLoginOrgUUID_Help)"
      presentation="$(presentation.ForceLoginOrgUUIDMachine)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Authentication"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <text
          id="ForceLoginOrgUUIDValue"
          valueName="forceLoginOrgUUID"
          required="true"/>
      </elements>
    </policy>

    <policy
      name="ForceLoginOrgUUIDUser"
      class="User"
      displayName="$(string.ForceLoginOrgUUID)"
      explainText="$(string.ForceLoginOrgUUID_Help)"
      presentation="$(presentation.ForceLoginOrgUUIDUser)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Authentication"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <text
          id="ForceLoginOrgUUIDUserValue"
          valueName="forceLoginOrgUUID"
          required="true"/>
      </elements>
    </policy>

    <!-- ================================================== -->
    <!-- Features                                           -->
    <!-- ================================================== -->

    <policy
      name="DesktopExtensionMachine"
      class="Machine"
      displayName="$(string.DesktopExtension)"
      explainText="$(string.DesktopExtension_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isDesktopExtensionEnabled">

      <parentCategory ref="Features"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="DesktopExtensionUser"
      class="User"
      displayName="$(string.DesktopExtension)"
      explainText="$(string.DesktopExtension_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isDesktopExtensionEnabled">

      <parentCategory ref="Features"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="ExtensionDirectoryMachine"
      class="Machine"
      displayName="$(string.ExtensionDirectory)"
      explainText="$(string.ExtensionDirectory_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isDesktopExtensionDirectoryEnabled">

      <parentCategory ref="Features"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="ExtensionDirectoryUser"
      class="User"
      displayName="$(string.ExtensionDirectory)"
      explainText="$(string.ExtensionDirectory_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isDesktopExtensionDirectoryEnabled">

      <parentCategory ref="Features"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="LocalMCPMachine"
      class="Machine"
      displayName="$(string.LocalMCP)"
      explainText="$(string.LocalMCP_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isLocalDevMcpEnabled">

      <parentCategory ref="Features"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="LocalMCPUser"
      class="User"
      displayName="$(string.LocalMCP)"
      explainText="$(string.LocalMCP_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isLocalDevMcpEnabled">

      <parentCategory ref="Features"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <!-- ================================================== -->
    <!-- Claude Code                                        -->
    <!-- ================================================== -->

    <policy
      name="ClaudeCodeDesktopMachine"
      class="Machine"
      displayName="$(string.ClaudeCodeDesktop)"
      explainText="$(string.ClaudeCodeDesktop_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isClaudeCodeForDesktopEnabled">

      <parentCategory ref="ClaudeCode"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="ClaudeCodeDesktopUser"
      class="User"
      displayName="$(string.ClaudeCodeDesktop)"
      explainText="$(string.ClaudeCodeDesktop_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="isClaudeCodeForDesktopEnabled">

      <parentCategory ref="ClaudeCode"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="EffortLevelMachine"
      class="Machine"
      displayName="$(string.EffortLevel)"
      explainText="$(string.EffortLevel_Help)"
      presentation="$(presentation.EffortLevelMachine)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="ClaudeCode"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <enum
          id="EffortLevelValue"
          valueName="effortLevel"
          required="true">

          <item displayName="$(string.EffortLow)">
            <value><string>low</string></value>
          </item>

          <item displayName="$(string.EffortMedium)">
            <value><string>medium</string></value>
          </item>

          <item displayName="$(string.EffortHigh)">
            <value><string>high</string></value>
          </item>

          <item displayName="$(string.EffortXHigh)">
            <value><string>xhigh</string></value>
          </item>

          <item displayName="$(string.EffortMax)">
            <value><string>max</string></value>
          </item>
        </enum>
      </elements>
    </policy>

    <policy
      name="EffortLevelUser"
      class="User"
      displayName="$(string.EffortLevel)"
      explainText="$(string.EffortLevel_Help)"
      presentation="$(presentation.EffortLevelUser)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="ClaudeCode"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <enum
          id="EffortLevelUserValue"
          valueName="effortLevel"
          required="true">

          <item displayName="$(string.EffortLow)">
            <value><string>low</string></value>
          </item>

          <item displayName="$(string.EffortMedium)">
            <value><string>medium</string></value>
          </item>

          <item displayName="$(string.EffortHigh)">
            <value><string>high</string></value>
          </item>

          <item displayName="$(string.EffortXHigh)">
            <value><string>xhigh</string></value>
          </item>

          <item displayName="$(string.EffortMax)">
            <value><string>max</string></value>
          </item>
        </enum>
      </elements>
    </policy>

    <!-- ================================================== -->
    <!-- Cowork                                             -->
    <!-- ================================================== -->

    <policy
      name="SecureVMFeaturesMachine"
      class="Machine"
      displayName="$(string.SecureVM)"
      explainText="$(string.SecureVM_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="secureVmFeaturesEnabled">

      <parentCategory ref="Cowork"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="SecureVMFeaturesUser"
      class="User"
      displayName="$(string.SecureVM)"
      explainText="$(string.SecureVM_Help)"
      key="SOFTWARE\Policies\Claude"
      valueName="secureVmFeaturesEnabled">

      <parentCategory ref="Cowork"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <enabledValue>
        <decimal value="1"/>
      </enabledValue>

      <disabledValue>
        <decimal value="0"/>
      </disabledValue>
    </policy>

    <policy
      name="AllowedWorkspaceFoldersMachine"
      class="Machine"
      displayName="$(string.AllowedWorkspaceFolders)"
      explainText="$(string.AllowedWorkspaceFolders_Help)"
      presentation="$(presentation.AllowedWorkspaceFoldersMachine)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Cowork"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <text
          id="AllowedWorkspaceFoldersValue"
          valueName="allowedWorkspaceFolders"
          required="true"/>
      </elements>
    </policy>

    <policy
      name="AllowedWorkspaceFoldersUser"
      class="User"
      displayName="$(string.AllowedWorkspaceFolders)"
      explainText="$(string.AllowedWorkspaceFolders_Help)"
      presentation="$(presentation.AllowedWorkspaceFoldersUser)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Cowork"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <text
          id="AllowedWorkspaceFoldersUserValue"
          valueName="allowedWorkspaceFolders"
          required="true"/>
      </elements>
    </policy>

    <policy
      name="CoworkEDRIntegrationMachine"
      class="Machine"
      displayName="$(string.CoworkEDRIntegration)"
      explainText="$(string.CoworkEDRIntegration_Help)"
      presentation="$(presentation.CoworkEDRIntegrationMachine)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Cowork"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <text
          id="CoworkEDRIntegrationValue"
          valueName="coworkEDRIntegration"
          required="true"/>
      </elements>
    </policy>

    <policy
      name="CoworkEDRVendorMachine"
      class="Machine"
      displayName="$(string.CoworkEDRVendor)"
      explainText="$(string.CoworkEDRVendor_Help)"
      presentation="$(presentation.CoworkEDRVendorMachine)"
      key="SOFTWARE\Policies\Claude">

      <parentCategory ref="Cowork"/>
      <supportedOn ref="SUPPORTED_ClaudeDesktop"/>

      <elements>
        <text
          id="CoworkEDRVendorValue"
          valueName="coworkEDRIntegrationVendor"
          required="true"/>
      </elements>
    </policy>

  </policies>
</policyDefinitions>